# Scheme Access Kit Environment Variables
# Group 5, Design Thinking, JAIN (Deemed-to-be University)

# Supabase Configuration (Optional for local development; app will use rich verified static dataset if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations-and-seed

# Application URL (for Open Graph and canonical metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
